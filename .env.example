GARMIN_EMAIL=
GARMIN_PASSWORD=
# String de conexão do Neon (Postgres) -- pegue em console.neon.tech, aba "Connect"
DATABASE_URL=postgresql://usuario:senha@seu-projeto.neon.tech/nomedobanco?sslmode=require
# Planilha de dor (Google Sheets) -- ver README para como gerar a credencial
GOOGLE_SHEETS_CREDENTIALS_PATH=.google_sheets_credentials.json
GOOGLE_SHEET_ID=
# Chave da API Gemini (Google AI Studio) -- gere em aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional -- padrão é gemini-2.5-flash (free tier) se não definido
GEMINI_MODEL=
